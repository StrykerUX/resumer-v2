// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials auth
  credits       Int       @default(5) // Welcome credits
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts    Account[]
  sessions    Session[]
  resumes     Resume[]
  creditTrans CreditTransaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Resumer-v2 specific models
model Resume {
  id           String   @id @default(cuid())
  userId       String
  originalName String   // Original filename
  fileUrl      String   // UploadThing URL
  fileSize     Int      // File size in bytes
  mimeType     String   // MIME type
  status       String   @default("uploaded") // uploaded, analyzing, completed, error
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis     Analysis?
  enhancements Enhancement[]
}

model Analysis {
  id              String   @id @default(cuid())
  resumeId        String   @unique
  aiAnalysis      Json     // Store AI analysis results
  suggestions     Json     // Store improvement suggestions
  atsScore        Int?     // ATS compatibility score
  categoryScores  Json?    // Detailed scoring breakdown by category
  pipelineData    Json?    // Pipeline execution data and timing
  finalScore      Int?     // Final overall score from pipeline
  grade           String?  // Letter grade (A+, A, B, C, D, F)
  marketReadiness String?  // Market readiness assessment
  createdAt       DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Enhancement {
  id              String   @id @default(cuid())
  resumeId        String
  enhancementType String   // "simple", "advanced", "specialized"
  jobDescription  String?  // For specialized enhancements
  enhancedContent Json     // The enhanced resume content
  creditsUsed     Int
  status          String   @default("processing") // processing, completed, error
  downloadUrl     String?
  pipelineData    Json?    // Pipeline execution data and timing
  scoreImprovement Json?   // Before/after score comparison
  finalScore      Int?     // Final score after enhancement
  processingTime  Int?     // Total processing time in milliseconds
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // Positive for purchases, negative for usage
  type        String   // "purchase", "usage", "welcome_bonus"
  description String?
  stripeSessionId String?
  currency    String?  // "MXN" o "USD" 
  priceId     String?  // Stripe price ID usado
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
